{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trapnest-architecture",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "architecture.henrywithu.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
